# ELLIGBLE runtime configuration (copy to your deployment's secret store; never commit
# real values). Every variable is validated at startup; the process refuses unsafe values.

# REQUIRED. PostgreSQL 16 connection (postgres:// or postgresql://). Keep the password in
# a secret or in PGPASSWORD rather than in shared files.
DATABASE_URL=postgresql://elligble@db.internal:5432/elligble

# production (default) | development | test. Production requires secure cookies and a
# schema check at startup.
ELLIGBLE_ENV=production

# Listen address and port (the container image uses 0.0.0.0:3000).
SA_HOST=0.0.0.0
SA_PORT=3000

# Built web client to serve from the same origin (the container image sets /app/web).
SA_STATIC_DIR=/app/web

# Session cookie Secure + __Host- prefix. Defaults to true in production and cannot be
# false there; serve over HTTPS (TLS at the reverse proxy).
SA_COOKIE_SECURE=true

# Extra origins allowed to send state-changing requests (same origin is always allowed).
# Comma-separated bare origins, for example https://ujian.sekolah.sch.id
SA_ALLOWED_ORIGINS=

# Schema at startup: check (default: refuse to start while migrations are pending; run
# `npm run migrate` as a release step), apply (apply pending migrations under the advisory
# lock; single-node deployments) or off (development only).
SA_MIGRATIONS_ON_START=check

# Seconds to wait for the database at startup before exiting (0 to 600, default 60).
SA_STARTUP_DB_WAIT_SECONDS=60

# Seconds between server finalizations of attempts whose time ran out while the student's
# device was away (1 to 300, default 15).
SA_EXPIRY_SWEEP_SECONDS=15

# Database pool size and connect timeout.
SA_DB_POOL_MAX=10
SA_DB_CONNECT_TIMEOUT_MS=5000
